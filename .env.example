# Copy this file to .env and fill in the values from your own Supabase project.
# Find these under Project Settings > API in the Supabase dashboard.
#
# The VITE_ copies are compiled into the browser bundle and must match the
# server copies exactly. The publishable key is safe to expose; the service
# role key is not and is only read on the server.

# Your project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# The publishable (anon) key. Protected by row level security, safe in the client.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The service role key. Bypasses row level security. Server only. Never commit
# this, never prefix it with VITE_, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The domain you deploy to, for example https://bonk.example.com. Used for
# canonical links, og:url and the sitemap. No trailing slash.
VITE_SITE_URL=

# Optional. Comma separated usernames that get moderator powers in rooms.
# Leave blank for none.
ADMIN_USERNAMES=

# Optional. Azure AI Content Safety for image moderation on uploads. If unset,
# the app falls back to a local NSFW model that ships with the dependencies.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
